# Copy to .env and fill in. Never commit your real .env.

# ── Database ────────────────────────────────────────────────
# Local dev (SQLite): keep schema.prisma provider = "sqlite"
DATABASE_URL="file:./dev.db"
# Production (Neon / Vercel Postgres): set provider = "postgresql" in
# prisma/schema.prisma and use the pooled connection string, e.g.
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# ── Site / SEO ──────────────────────────────────────────────
# Public URL of the deployed site (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js ─────────────────────────────────────────────────
# Generate with:  npx auth secret    (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Set to your deployed URL in production, e.g. https://fluentpath.vercel.app
# AUTH_URL="http://localhost:3000"

# ── Google sign-in (optional) ───────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI Tutor (final phase, optional) ────────────────────────
# From https://console.anthropic.com — pay-per-use, separate from Pro/Max.
ANTHROPIC_API_KEY=""
