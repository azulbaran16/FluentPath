# Copy to .env and fill in. Never commit your real .env.

# ── Database (PostgreSQL) ───────────────────────────────────
# The schema uses postgresql. For local dev, start the bundled Postgres
# (`docker compose up -d db`) and use:
DATABASE_URL="postgresql://fluentpath:fluentpath@localhost:5432/fluentpath"
# In production (Coolify), use the Postgres connection string from your DB.
# See DEPLOY-COOLIFY.md for the full self-hosting guide.

# ── Site / SEO ──────────────────────────────────────────────
# Public URL of the deployed site (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js ─────────────────────────────────────────────────
# Generate with:  npx auth secret    (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Set to your deployed URL in production, e.g. https://fluentpath.yourdomain.com
# AUTH_URL="http://localhost:3000"
# Behind a reverse proxy (Coolify/Traefik), also set:
# AUTH_TRUST_HOST="true"

# ── Google sign-in (optional) ───────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email / SMTP (optional — for password-reset emails) ─────
# Without these, reset links are logged to the server console instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FluentPath <no-reply@yourdomain.com>"

# ── Stripe (freemium / Pro subscription) ───────────────────
# From https://dashboard.stripe.com/apikeys (use test keys while developing).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` (CLI) in dev, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=""
# Optional: a recurring Price id. If empty, a $5/mo price is created inline.
STRIPE_PRICE_ID=""

# ── AI Tutor (Rumi) ─────────────────────────────────────────
# From https://console.anthropic.com — pay-per-use, separate from Pro/Max.
# Without it the tutor runs in demo mode. Uses claude-haiku-4-5 + a daily cap.
ANTHROPIC_API_KEY=""
