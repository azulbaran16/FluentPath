// FluentPath data model.
// Production: PostgreSQL (set DATABASE_URL to your Coolify Postgres).
// For local dev, run the bundled Postgres: `docker compose up -d db`
// with DATABASE_URL="postgresql://fluentpath:fluentpath@localhost:5432/fluentpath".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  // null for OAuth-only accounts (e.g. Google)
  passwordHash   String?
  image          String?
  // estimated CEFR level from the placement test
  level          String?
  // serialized ProgressState (JSON string — portable across SQLite/Postgres)
  progress       String?
  // serialized CelpipProgressState — the server home of the client's
  // `fluentpath.celpip.v1` store (D-05). Deliberately its own column rather
  // than a key inside the progress blob: the two domains stay decoupled and a
  // routine XP save does not re-upload every essay text. A JSON string for the
  // same engine-portability reason as `progress` above, and nullable with no
  // default so the container's start-up schema push stays purely additive.
  celpipProgress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Stripe subscription (freemium "Pro")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  stripeStatus         String?
  proUntil             DateTime?

  // Referrals: each user gets a shareable code; referredById points at the
  // referrer who brought them in.
  referralCode String? @unique
  referredById String?

  resetTokens PasswordResetToken[]
}

model TutorUsage {
  id     String @id @default(cuid())
  userId String
  // YYYY-MM-DD (UTC) — one row per user per day
  day    String
  count  Int    @default(0)

  @@unique([userId, day])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  // sha256 hash of the token sent by email (never store the raw token)
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
