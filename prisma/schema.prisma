// FluentPath data model.
// Dev: SQLite (file). Prod: switch `provider` to "postgresql" and point
// DATABASE_URL at Neon/Vercel Postgres — the models are portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  // null for OAuth-only accounts (e.g. Google)
  passwordHash String?
  image        String?
  // estimated CEFR level from the placement test
  level        String?
  // serialized ProgressState (JSON string — portable across SQLite/Postgres)
  progress     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Stripe subscription (freemium "Pro")
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?
  stripeStatus         String?
  proUntil             DateTime?

  resetTokens  PasswordResetToken[]
}

model TutorUsage {
  id     String @id @default(cuid())
  userId String
  // YYYY-MM-DD (UTC) — one row per user per day
  day    String
  count  Int    @default(0)

  @@unique([userId, day])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  // sha256 hash of the token sent by email (never store the raw token)
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
